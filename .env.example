# Copy to .env and fill in generated secrets. Never commit .env.
# Generate secrets with: openssl rand -base64 48

# Spring
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# PostgreSQL bootstrap account (used only to initialize a new volume; use a unique password)
DB_BOOTSTRAP_USERNAME=trustagro_bootstrap
DB_BOOTSTRAP_PASSWORD=

# Least-privilege application account (required in production; use a unique password)
DB_URL=jdbc:postgresql://postgres:5432/trust_agro_db
DB_USERNAME=trustagro_app
DB_PASSWORD=

# JWT (REQUIRED, generated secret of at least 32 characters)
APP_JWT_SECRET=

# CORS (REQUIRED explicit origins; do not use sole *)
APP_CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

FRONTEND_PORT=3000

# Optional
UPLOAD_DIR=./uploads

# Optional one-time initial administrator (required at startup only if no admin exists)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=System Administrator
