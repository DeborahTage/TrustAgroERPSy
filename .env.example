# Copy to .env and fill in real values. Never commit .env with secrets.

# Spring
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

# Database (REQUIRED in production)
DB_URL=jdbc:postgresql://postgres:5432/trust_agro_db
DB_USERNAME=trustagro
DB_PASSWORD=<generate-secure-db-password>
POSTGRES_PORT=5432

# JWT (REQUIRED, >= 32 characters)
APP_JWT_SECRET=<generate-secure-secret-at-least-32-chars>

# CORS (REQUIRED explicit origins; do not use sole *)
APP_CORS_ALLOWED_ORIGINS=https://app.example.com,https://www.example.com

# Frontend build-time API base URL
REACT_APP_API_URL=https://api.example.com
BACKEND_PORT=8081
FRONTEND_PORT=3000

# Optional
UPLOAD_DIR=./uploads

# Initial Administrator Provisioning (provisions the first admin on a clean database)
# Leave blank if you will create the admin user through out-of-band management.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=<generate-secure-admin-password-min-8-chars>
INITIAL_ADMIN_NAME=System Administrator
